---
import Layout from '../layouts/Layout.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import Tagline from '../components/Tagline.astro';
import Dishes from '../components/Dishes.astro';
import Press from '../components/Press.astro';
import Experiences from '../components/Experiences.astro';
import Faq from '../components/Faq.astro';
import Gift from '../components/Gift.astro';
import FinalCta from '../components/FinalCta.astro';
import { faqs } from '../data/arko';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': new URL('/#faq', Astro.site).href,
  inLanguage: 'es-ES',
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
  })),
};
---

<Layout
  title="Arko · Sushi y cocina nikkei en el Eixample, Barcelona"
  description="Restaurante japonés con alma mediterránea en Enric Granados 63, Barcelona. Sushi, nigiri y wagyu, con menús para dos desde 150 €. Abierto todos los días."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <ScrollWorld />
  <Tagline />
  <Dishes />
  <Press />
  <Experiences />
  <Faq />
  <Gift />
  <FinalCta />
</Layout>
