---
import { paseo } from '../data/arko';

// Una parada del paseo. El artículo marca la distancia de scroll; el texto se queda abajo a la izquierda
// mientras la cámara avanza y sale empujado por la parada siguiente.
interface Props {
  index: number;
  /** Sin eyebrow, la parada lo pone dentro de su propio titular (la entrada lo mete en el h1). */
  eyebrow?: string;
  spy?: string;
}

const { index, eyebrow, spy = '#nikkei' } = Astro.props;
const parada = paseo.paradas[index];
const pad = (n: number) => String(n).padStart(2, '0');
---

<article
  id={parada.id}
  data-stop
  data-focus={parada.focus}
  data-spy={spy}
  class="stop pointer-events-none flex min-h-[200svh] flex-col justify-end"
>
  <div
    class="stop-body pointer-events-auto sticky bottom-0 flex w-full max-w-2xl xl:max-w-3xl flex-col items-start px-4 pt-32 pb-12 md:px-12 lg:pb-16 xl:px-20"
  >
    <p class="flex items-center gap-2 text-xs tracking-widest text-crema/60 uppercase">
      <span class="tabular-nums">{pad(index + 1)} / {pad(paseo.paradas.length)}</span>
      <span aria-hidden="true" class="size-1 rounded-full bg-teja"></span>
      <span>{parada.lugar}</span>
    </p>
    {eyebrow && <p class="mt-4 text-xs font-medium tracking-widest text-teja uppercase">{eyebrow}</p>}
    <slot />
  </div>
</article>

<style>
  :global(.js) .stop-body > :global(*) {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  :global(.js) .stop.is-current .stop-body > :global(*),
  :global(.js) .stop-body:focus-within > :global(*) {
    opacity: 1;
    transform: none;
    transition-duration: 1000ms;
  }

  .stop.is-current .stop-body > :global(:nth-child(2)) { transition-delay: 60ms; }
  .stop.is-current .stop-body > :global(:nth-child(3)) { transition-delay: 120ms; }
  .stop.is-current .stop-body > :global(:nth-child(4)) { transition-delay: 180ms; }
  .stop.is-current .stop-body > :global(:nth-child(5)) { transition-delay: 240ms; }
  .stop.is-current .stop-body > :global(:nth-child(6)) { transition-delay: 300ms; }
  .stop.is-current .stop-body > :global(:nth-child(7)) { transition-delay: 360ms; }
  .stop.is-current .stop-body > :global(:nth-child(8)) { transition-delay: 420ms; }

  :global(.js) .stop:not(.is-current) .stop-body:not(:focus-within) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .stop-body > :global(*) {
      transform: none;
    }
  }
</style>
