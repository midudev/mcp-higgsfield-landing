---
import Spiral from './Spiral.astro';
import { arko } from '../data/arko';

interface Props {
  label?: string;
  size?: 'base' | 'sm';
  class?: string;
}

const { label = 'Reservar mesa', size = 'base', class: className = '' } = Astro.props;
const text = size === 'sm' ? 'text-sm' : 'text-base';
---

<!-- Las ondas de arena van en el envoltorio, por detrás del botón -->
<span class:list={['spiral-wrap relative isolate inline-flex rounded-full', className]}>
  <Spiral
    rings={6}
    class="spiral-rings pointer-events-none absolute top-1/2 left-1/2 z-0 size-40 text-teja/60"
  />
  <a
    href={arko.reserveUrl}
    target="_blank"
    rel="noopener"
    class:list={[
      'relative z-10 inline-flex items-center justify-center gap-2 rounded-full bg-teja px-3 py-2 font-semibold text-ink',
      'transition-[background-color,transform] duration-700 ease-heavy hover:bg-teja-soft active:scale-[0.98]',
      text,
    ]}
  >
    <span>{label}</span>
    <svg viewBox="0 0 256 256" class="size-4" aria-hidden="true" fill="currentColor">
      <!-- Phosphor: arrow-up-right (regular) -->
      <path
        d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"
      ></path>
    </svg>
    <span class="sr-only">(se abre en una pestaña nueva)</span>
  </a>
</span>
