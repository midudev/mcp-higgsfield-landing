---
// Las espirales de arena de la barra: círculos concéntricos en SVG.
interface Props {
  rings?: number;
  class?: string;
  strokeWidth?: number;
}

const { rings = 7, class: className = '', strokeWidth = 1 } = Astro.props;
const step = 48 / rings;
---

<svg
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  class={className}
>
  {Array.from({ length: rings }, (_, i) => (
    <circle cx="50" cy="50" r={step * (i + 1)} vector-effect="non-scaling-stroke" />
  ))}
</svg>
