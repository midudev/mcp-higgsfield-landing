---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contacto, links, nav } from '../data/arko';
---

<a
  href="#contenido"
  class="btn btn-primary btn-sm fixed top-4 left-4 z-[60] -translate-y-24 focus-visible:translate-y-0"
>
  <span>Saltar al contenido</span>
</a>

<header
  class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-6 lg:justify-start lg:px-8 xl:px-20"
>
  <div
    class="pointer-events-auto flex w-max items-center gap-6 rounded-full bg-bg/60 p-2 pl-6 ring-1 ring-crema/10 backdrop-blur-xl lg:gap-5"
  >
    <a href="#inicio" class="flex h-9 items-center rounded-full text-crema" aria-label="Arko, volver al inicio">
      <Logo class="h-4 w-auto" />
    </a>

    <nav aria-label="Principal" class="relative hidden lg:block">
      <span aria-hidden="true" class="nav-indicator absolute top-0 left-0 h-9 rounded-full bg-crema/[0.07]"></span>
      <ul class="relative flex items-center text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                class="flex h-9 items-center rounded-full px-3 text-crema/70 transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-crema aria-[current=true]:text-crema"
              >
                <span class="text-trim">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a href={links.reservar} class="btn btn-primary btn-sm px-4">
        <span>Reservar</span>
      </a>
      <button
        type="button"
        class="menu-toggle relative size-9 rounded-full text-crema transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-crema/10 lg:hidden"
        aria-expanded="false"
        aria-controls="menu"
        aria-label="Abrir menú"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="menu"
  class="menu invisible fixed inset-0 z-40 flex flex-col justify-between bg-bg/80 px-4 pt-32 pb-12 opacity-0 backdrop-blur-3xl transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] lg:hidden"
  inert
>
  <nav aria-label="Menú móvil">
    <ul class="flex flex-col items-center gap-6 text-center">
      {
        nav.map((item, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a href={item.href} data-menu-link class="font-display text-4xl text-crema">
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="menu-item pt-6" style={`--i:${nav.length}`}>
        <a href={links.reservar} class="btn btn-primary"><span>Reservar mesa</span></a>
      </li>
    </ul>
  </nav>

  <div class="menu-item flex flex-col items-center gap-2 text-sm text-crema/70" style={`--i:${nav.length + 1}`}>
    <a href={links.telefono} class="link inline-flex items-center gap-2">
      <Icon name="phone" />
      {contacto.telefono}
    </a>
    <p>{contacto.calle} · {contacto.horario}</p>
  </div>
</div>

<style>
  .menu-toggle span {
    position: absolute;
    top: 50%;
    left: 10px;
    width: 16px;
    height: 1.5px;
    margin-top: -0.75px;
    border-radius: 9999px;
    background-color: currentColor;
    transition: transform 700ms var(--ease-fluid);
  }

  .menu-toggle span:nth-child(1) {
    transform: translateY(-3px);
  }

  .menu-toggle span:nth-child(2) {
    transform: translateY(3px);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(0) rotate(-45deg);
  }

  .menu[data-open] {
    visibility: visible;
    opacity: 1;
  }

  .menu-item {
    opacity: 0;
    transform: translateY(3rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .menu[data-open] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(100ms + var(--i, 0) * 50ms);
  }

  /* Píldora que se desliza hasta la sección activa. */
  .nav-indicator {
    width: var(--w, 0);
    translate: var(--x, 0) 0;
    opacity: 0;
    transition:
      translate 700ms var(--ease-fluid),
      width 700ms var(--ease-fluid),
      opacity 700ms var(--ease-fluid);
  }

  .nav-indicator[data-visible] {
    opacity: 1;
  }

  .nav-indicator[data-instant] {
    transition: opacity 700ms var(--ease-fluid);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu');
  const main = document.getElementById('contenido');
  const footer = document.querySelector('footer');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.toggleAttribute('data-open', open);
    menu.inert = !open;
    if (main) main.inert = open;
    if (footer) footer.inert = open;
    if (open) {
      window.lenis?.stop();
      menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
    } else {
      window.lenis?.start();
    }
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  menu?.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      event.preventDefault();
      setOpen(false);
      if (window.lenis) window.lenis.scrollTo(target);
      else target.scrollIntoView();
    });
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });

  // Indica en la navegación la sección que se está viendo.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const indicator = document.querySelector<HTMLElement>('.nav-indicator');

  const moveIndicator = () => {
    if (!indicator) return;
    const active = links.find((link) => link.getAttribute('aria-current') === 'true');
    if (!active) {
      indicator.removeAttribute('data-visible');
      return;
    }
    // Si estaba oculta, aparece en su sitio en vez de deslizarse desde el anterior.
    indicator.toggleAttribute('data-instant', !indicator.hasAttribute('data-visible'));
    indicator.style.setProperty('--x', `${active.offsetLeft}px`);
    indicator.style.setProperty('--w', `${active.offsetWidth}px`);
    void indicator.offsetWidth;
    indicator.removeAttribute('data-instant');
    indicator.setAttribute('data-visible', '');
  };

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const href = (entry.target as HTMLElement).dataset.spy;
        links.forEach((link) => link.setAttribute('aria-current', String(link.getAttribute('href') === href)));
        moveIndicator();
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  document.querySelectorAll('[data-spy]').forEach((el) => spy.observe(el));

  const list = links[0]?.closest('ul');
  if (list) new ResizeObserver(moveIndicator).observe(list);
</script>
